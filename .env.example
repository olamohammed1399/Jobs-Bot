TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_CHAT_ID="your-telegram-chat-id"
TELEGRAM_DISABLE_WEB_PAGE_PREVIEW="true"
CRON_SECRET="use-a-long-random-secret"
BOT_SETTINGS_PATH="settings.json"

# Optional for zero-cost cloud hosts with ephemeral filesystems.
# Paste the full cookies.json content as one JSON value in the hosting dashboard.
LINKEDIN_COOKIES_JSON='[{"name":"li_at","value":"replace-me","domain":".linkedin.com","path":"/"}]'

# Optional alternative to LINKEDIN_COOKIES_JSON.
# LINKEDIN_COOKIES_BASE64="base64-encoded-cookies-json"

# Optional. Paste settings.json as one JSON value if you do not want to use the
# committed settings.json on the host.
# BOT_SETTINGS_JSON='{"hours":5,"max_pages":1,"page_size":25,"max_send_per_run":10,"request_timeout":[10,30],"db_path":"scrape_jobs.sqlite","cookies_path":"cookies.json","work_type_filters":{"remote":"2","all":"1%2C2%2C3"},"locations":[],"keyword_groups":[],"title_keywords":[]}'
